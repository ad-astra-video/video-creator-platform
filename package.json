{
  "name": "video-creator-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless credits + platform-fee backend for the Video Creator desktop app (Stripe checkout -> PymtHouse allowance -> deposit-to-inference)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate": "wrangler d1 migrations apply DB --remote",
    "d1:list": "wrangler d1 list",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/worker.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke.mjs",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  },
  "dependencies": {
    "@pymthouse/builder-sdk": "^0.6.3",
    "zod": "^4.4.3"
  }
}
