{
  "name": "ltx-credits-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless credits + platform-fee backend for LTX-Desktop (Stripe checkout -> PymtHouse allowance -> deposit-to-inference)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate": "wrangler d1 migrations apply DB --remote",
    "d1:list": "wrangler d1 list",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.86.0"
  }
}
